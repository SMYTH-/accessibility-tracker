# Copy to .env.local for real Supabase Auth + Postgres (non-production / local).
# Without URL + anon key, the app runs in mock auth mode with local file challenge store.
# Do not commit .env.local. Do not paste secret values into chat.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origin used in email redirectTo / emailRedirectTo links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: required for privileged lifecycle tick / admin smoke scripts
# SUPABASE_SERVICE_ROLE_KEY=

# Membership NOTIF-01 delivery (server-only; never commit values)
# Prefer Resend when available:
# RESEND_API_KEY=
# EMAIL_FROM=Accountability Tracker <onboarding@resend.dev>
# M3_TEST_INBOX=you@example.com
# Otherwise evidence uses Ethereal test inbox (auto; cached under .data/):
# EMAIL_PROVIDER=ethereal

# Optional: force mock even if Supabase vars are set
# AUTH_MODE=mock
# NEXT_PUBLIC_AUTH_MODE=mock
