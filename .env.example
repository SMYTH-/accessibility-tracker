# Copy to .env.local for real Supabase Auth (non-production / local).
# Without URL + anon key, the app runs in mock auth mode.
# Do not commit .env.local. Do not paste secret values into chat.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origin used in email redirectTo / emailRedirectTo links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: force mock even if Supabase vars are set
# AUTH_MODE=mock
