{
  "name": "accountability-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "smoke:m2": "node scripts/m2-lifecycle-smoke.mjs && npx --yes tsx scripts/m2-service-smoke.ts",
    "smoke:m3": "npx --yes tsx scripts/m3-service-smoke.ts",
    "smoke:m4": "node scripts/m4-activation-week-smoke.mjs && npx --yes tsx scripts/m4-service-smoke.ts",
    "smoke:m5": "node scripts/m5-week-helpers-smoke.mjs && npx --yes tsx scripts/m5-service-smoke.ts",
    "evidence:m2:pg": "node --env-file=.env.local scripts/m2-postgres-evidence.mjs",
    "evidence:m2:ui": "node scripts/m2-supabase-ui-evidence.mjs",
    "evidence:m3:pg": "node --env-file=.env.local scripts/m3-postgres-evidence.mjs",
    "evidence:m3:ui": "node --env-file=.env.local scripts/m3-supabase-ui-evidence.mjs",
    "evidence:m3:email": "node --env-file=.env.local scripts/m3-email-delivery-evidence.mjs",
    "evidence:m4:pg": "node --env-file=.env.local scripts/m4-postgres-evidence.mjs",
    "evidence:m4:ui": "node --env-file=.env.local scripts/m4-supabase-ui-evidence.mjs",
    "evidence:m5:pg": "node --env-file=.env.local scripts/m5-postgres-evidence.mjs",
    "evidence:m5:ui": "node --env-file=.env.local scripts/m5-supabase-ui-evidence.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "^15.5.7",
    "nodemailer": "^10.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.7",
    "playwright": "^1.65.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "description": "Accountability Tracker — M5 contribution recording"
}
